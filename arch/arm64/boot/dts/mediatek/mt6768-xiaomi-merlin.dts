/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "mt6768.dtsi"
#include "mt6358.dtsi"

/ {
	model = "Xiaomi Redmi Note 9";
	compatible = "xiaomi,merlin", "mediatek,mt6768";

	aliases {
		serial0 = &uart0;
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5020000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4460000>;
		constant-charge-current-max-microamp = <1800000>;
		constant-charge-voltage-max-microvolt = <4400000>;
		precharge-current-microamp = <500000>;
		charge-term-current-microamp = <200000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 =
			<4415000 100>, <4403332 99>, <4392914 98>, <4382332 97>, <4371835 96>,
			<4361543 95>, <4350810 94>, <4340714 93>, <4329956 92>, <4318579 91>,
			<4306867 90>, <4295179 89>, <4283435 88>, <4271687 87>, <4259350 86>,
			<4247362 85>, <4235596 84>, <4223897 83>, <4211907 82>, <4199500 81>,
			<4187494 80>, <4175782 79>, <4164534 78>, <4153269 77>, <4141910 76>,
			<4130682 75>, <4119309 74>, <4108118 73>, <4097235 72>, <4086702 71>,
			<4076371 70>, <4065800 69>, <4055664 68>, <4046062 67>, <4036453 66>,
			<4026699 65>, <4017280 64>, <4007647 63>, <3998754 62>, <3989874 61>,
			<3980651 60>, <3970797 59>, <3959777 58>, <3947674 57>, <3933228 56>,
			<3919475 55>, <3908011 54>, <3898616 53>, <3890554 52>, <3883887 51>,
			<3877227 50>, <3871148 49>, <3865361 48>, <3859481 47>, <3853785 46>,
			<3848747 45>, <3843658 44>, <3839345 43>, <3834617 42>, <3830063 41>,
			<3825797 40>, <3821820 39>, <3818363 38>, <3815035 37>, <3811115 36>,
			<3807426 35>, <3804383 34>, <3801472 33>, <3798268 32>, <3794935 31>,
			<3791601 30>, <3787789 29>, <3783618 28>, <3779183 27>, <3774521 26>,
			<3769970 25>, <3765259 24>, <3760259 23>, <3755580 22>, <3751617 21>,
			<3747965 20>, <3743986 19>, <3739581 18>, <3734156 17>, <3727489 16>,
			<3721270 15>, <3715374 14>, <3707921 13>, <3700611 12>, <3696039 11>,
			<3694701 10>, <3693658 9>, <3691991 8>, <3689935 7>, <3684304 6>,
			<3666941 5>, <3631783 4>, <3578157 3>, <3507050 2>, <3393304 1>,
			<3143984 0>;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0>;
	};

	reg_lcd_bias_enn: regulator-lcd-bias-enn {
		compatible = "regulator-fixed";
		regulator-name = "lcd_bias_enn";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
		gpio = <&pio 165 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&panel_enn_pins>;
		pinctrl-names = "default";
		enable-active-high;
		startup-delay-us = <5000>;
	};

	reg_lcd_bias_enp: regulator-lcd-bias-enp {
		compatible = "regulator-fixed";
		regulator-name = "lcd_bias_enp";
		regulator-min-microvolt = <5500000>;
		regulator-max-microvolt = <5500000>;
		gpio = <&pio 169 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&panel_enp_pins>;
		pinctrl-names = "default";
		enable-active-high;
		startup-delay-us = <3000>;
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;
	};
};

&cci {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu0 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu1 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu2 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu3 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu4 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu5 {
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu6 {
	proc-supply = <&mt6358_vproc11_reg>;
};

&cpu7 {
	proc-supply = <&mt6358_vproc11_reg>;
};

&gpu {
	mali-supply = <&mt6358_vgpu_reg>;
	status = "okay";
};

&mfg_async {
	domain-supply = <&mt6358_vsram_gpu_reg>;
};

&i2c1 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";

	magnetometer@c {
		compatible = "asahi-kasei,ak09918", "asahi-kasei,ak09912";
		reg = <0x0c>;
		vdd-supply = <&mt6358_vio18_reg>;
		vid-supply = <&mt6358_vio18_reg>;
	};

	light-sensor@47 {
		compatible = "sensortek,stk3310";
		reg = <0x47>;
		interrupt-parent = <&pio>;
		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&light_sensor_pins>;
		pinctrl-names = "default";
	};
};

&i2c7 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c7_pins>;
	pinctrl-names = "default";
	status = "okay";

	charger@55 {
		compatible = "qcom,smb1351-charger";
		reg = <0x55>;
		interrupt-parent = <&pio>;
		interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
		monitored-battery = <&battery>;
		enable-gpios = <&pio 166 GPIO_ACTIVE_LOW>;
		input-current-limit-microamp = <1500000>;
		pinctrl-0 = <&charger_pins>;
		pinctrl-names = "default";

		usb-vbus {
			regulator-name = "smb1351-usb-otg-vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
		};
	};
};

&mfg {
	domain-supply = <&mt6358_vgpu_reg>;
};

&mmc0 {
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	non-removable;
	supports-cqe;
	cap-mmc-hw-reset;
	hs400-ds-delay = <0x12814>;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
	pinctrl-0 = <&mmc0_default_pins>;
	pinctrl-1 = <&mmc0_uhs_pins>;
	pinctrl-names = "default", "state_uhs";

	status = "okay";
};

&mmc1 {
	assigned-clocks = <&apmixedsys CLK_APMIXED_MSDCPLL>,
			  <&topckgen CLK_TOP_MSDC30_1_SEL>;
	assigned-clock-rates = <400000000>;
	assigned-clock-parents = <0>, <&topckgen CLK_TOP_MSDCPLL_D2>;

	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 18 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_reg>;
	vqmmc-supply = <&mt6358_vmc_reg>;

	/*
	 * SIM and microSD tray shares the same output detect pin. All 3 GPIOs
	 * for microSD, SIM1 and SIM2 detection must be pulled up high to avoid
	 * breaking each other.
	 */
	pinctrl-0 = <&mmc1_pins>, <&sim_pins>;
	pinctrl-1 = <&mmc1_pins>, <&sim_pins>;
	pinctrl-names = "default", "state_uhs";

	status = "okay";
};

&mt6358gauge {
	monitored-battery = <&battery>;
	shunt-resistor-micro-ohms = <10000>;
	mediatek,car-tune-value = <990>;
	status = "okay";
};

&mt6358_vdram2_reg {
	regulator-always-on;
};

&mt6358_vgpu_reg {
	regulator-min-microvolt = <612500>;
	regulator-max-microvolt = <950000>;

	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

/* STK3310 */
&mt6358_vio28_reg {
	regulator-always-on;
};

&mt6358_vsram_gpu_reg {
	regulator-min-microvolt = <850000>;
	regulator-max-microvolt = <1050000>;

	regulator-coupled-with = <&mt6358_vgpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

&mt6358regulator {
	vs1-ldo1-supply = <&mt6358_vs1_reg>;
	vs2-ldo1-supply = <&mt6358_vdram1_reg>;
	vs2-ldo2-supply = <&mt6358_vs2_reg>;
	vs2-ldo3-supply = <&mt6358_vs2_reg>;
	vs2-ldo4-supply = <&mt6358_vs2_reg>;
};

&pio {
	charger_pins: charger-pins {
		pins-int {
			pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
			input-enable;
			bias-pull-up;
		};

		pins-en {
			pinmux = <PINMUX_GPIO166__FUNC_GPIO166>;
			output-low;
			bias-disable;
		};
	};

	i2c1_pins: i2c1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO84__FUNC_SCL1>,
				 <PINMUX_GPIO81__FUNC_SDA1>;
			bias-pull-up;
			input-enable;
		};
	};

	i2c7_pins: i2c7-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO175__FUNC_SCL7>,
				 <PINMUX_GPIO176__FUNC_SDA7>;
			bias-pull-up;
			input-enable;
		};
	};

	light_sensor_pins: light-sensor-pins {
		pins-int {
			pinmux = <PINMUX_GPIO10__FUNC_GPIO10>;
			input-enable;
			bias-pull-up;
		};
	};

	mmc0_default_pins: mmc0-default-pins {
		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <4>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <4>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc0_uhs_pins: mmc0-uhs-pins {
		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <6>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd {
			pinmux = <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			input-enable;
		};

		pins-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>;
			input-enable;
			drive-strength = <6>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <6>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc1_pins: mmc1-pins {
		pins-cd {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			bias-pull-up;
			input-enable;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO171__FUNC_MSDC1_CLK>;
			drive-strength = <4>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO164__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO163__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO162__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO161__FUNC_MSDC1_DAT3>,
				 <PINMUX_GPIO170__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	panel_enn_pins: panel-enn-pins {
		pins-en {
			pinmux = <PINMUX_GPIO165__FUNC_GPIO165>;
			bias-disable;
		};
	};

	panel_enp_pins: panel-enp-pins {
		pins-en {
			pinmux = <PINMUX_GPIO169__FUNC_GPIO169>;
			bias-disable;
		};
	};

	panel_pins: panel-pins {
		pins-rst {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			bias-disable;
		};
	};

	pwrap_pins: pwrap-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO145__FUNC_PWRAP_SPI0_CSN>,
				 <PINMUX_GPIO146__FUNC_PWRAP_SPI0_MO>,
				 <PINMUX_GPIO147__FUNC_PWRAP_SPI0_CK>;
			bias-disable;
		};

		pins-mi {
			pinmux = <PINMUX_GPIO144__FUNC_PWRAP_SPI0_MI>;
			input-enable;
			bias-pull-down;
		};
	};

	sim_pins: sim-pins {
		pins-cd {
			pinmux = <PINMUX_GPIO46__FUNC_MD_INT2_C2K_UIM1_HOT_PLUG>,
				 <PINMUX_GPIO47__FUNC_MD_INT1_C2K_UIM0_HOT_PLUG>;
			input-enable;
			bias-pull-up;
		};
	};

	uart0_pins: uart0-pins {
		pins-rx {
			pinmux = <PINMUX_GPIO95__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};

		pins-tx {
			pinmux = <PINMUX_GPIO96__FUNC_UTXD0>;
		};
	};
};

&pmic {
	interrupts-extended = <&pio 144 IRQ_TYPE_LEVEL_HIGH>;
};

&pwrap {
	pinctrl-0 = <&pwrap_pins>;
	pinctrl-names = "default";
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb {
	dr_mode = "otg";
	status = "okay";
};

&u2phy {
	status = "okay";
};
