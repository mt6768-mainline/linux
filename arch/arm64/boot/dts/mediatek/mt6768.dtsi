#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/clock/mediatek,mt6768-clock.h>
#include <dt-bindings/mailbox/mediatek,mt6768-gce.h>
#include <dt-bindings/memory/mediatek,mt6768-memory-port.h>
#include <dt-bindings/pinctrl/mediatek,mt6768-pinfunc.h>
#include <dt-bindings/power/mediatek,mt6768-power-controller.h>
#include <dt-bindings/reset/mediatek,mt6768-resets.h>

/ {
	interrupt-parent = <&sysirq>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		aal0 = &aal0;
		ccorr0 = &ccorr0;
		color0 = &color0;
		dither0 = &dither0;
		dsi0 = &dsi0;
		gamma0 = &gamma0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		ovl0 = &ovl0;
		ovl-2l0 = &ovl_2l0;
		rdma0 = &rdma0;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		spi3 = &spi3;
		spi4 = &spi4;
		spi5 = &spi5;
	};

	cci: cci {
		compatible = "mediatek,mt6768-cci", "mediatek,mt8183-cci";
		clocks = <&mcucfg CLK_MCU_PLL_BUS_SEL>,
			 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
		clock-names = "cci", "intermediate";
		operating-points-v2 = <&cci_opp>;
		nvmem-cells = <&cpu_speedbin>;
	};

	clk13m: clk13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	clk26m: clk26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk32k: clk32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x000>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x600>;
			enable-method = "psci";
			dynamic-power-coefficient = <275>;
			capacity-dmips-mhz = <1024>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_L_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster1_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x700>;
			enable-method = "psci";
			dynamic-power-coefficient = <275>;
			capacity-dmips-mhz = <1024>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
			clocks = <&mcucfg CLK_MCU_PLL_L_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster1_opp>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed_grade";
			mediatek,cci = <&cci>;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu6>;
				};

				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		l2_0: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <393216>; // 64K x 6
			cache-line-size = <64>;
			cache-sets = <512>; // I guess
			next-level-cache = <&l3>;
			cache-unified;
		};

		l2_1: l2-cache1 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <524288>; // 256K x 2
			cache-line-size = <64>;
			cache-sets = <512>;
			next-level-cache = <&l3>;
			cache-unified;
		};
	};

	dsu-pmu {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
		       <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
	};

	l3: l3-cache {
		compatible = "cache";
		cache-level = <3>;
		cache-size = <1048576>;
		cache-line-size = <64>;
		cache-sets = <1024>;
		cache-unified;
	};

	/*
	 * - Level 0: MT6767 (Helio G70)
	 *   Segments 3, 4 -> BIT(3) | BIT(4) = 0x018
	 * - Level 1: MT6768 (Helio P65)
	 *   Segments 1, 2, 7, 8 -> BIT(1) | BIT(2) | BIT(7) | BIT(8) = 0x186
	 * - Level 2: MT6769 (Helio G80/G85/G88 and friends)
	 *   Segments 5, 6, 9, 10 -> BIT(5) | BIT(6) | BIT(9) | BIT(10) = 0x660
	 *
	 * Supported HW bitmasks used in OPP tables:
	 * - 0x7fe: All variants (Level 0 | Level 1 | Level 2 = 0x018 | 0x186 | 0x660)
	 * - 0x7e6: Level 1 & Level 2 (0x186 | 0x660)
	 * - 0x660: Level 2 only (Helio G80/G85/G88 and friends)
	 * - 0x186: Level 1 only (Helio P65)
	 * - 0x018: Level 0 only (Helio G70)
	 */
	cci_opp: opp-table-cci {
		compatible = "operating-points-v2";
		opp-shared;

		cci_opp0: opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <650000>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp1: opp-558000000 {
			opp-hz = /bits/ 64 <558000000>;
			opp-microvolt = <675000>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp2: opp-575000000 {
			opp-hz = /bits/ 64 <575000000>;
			opp-microvolt = <687500>;
			opp-supported-hw = <0x018>;
		};

		cci_opp3: opp-593000000 {
			opp-hz = /bits/ 64 <593000000>;
			opp-microvolt = <693750>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp4: opp-610000000 {
			opp-hz = /bits/ 64 <610000000>;
			opp-microvolt = <700000>;
			opp-supported-hw = <0x018>;
		};

		cci_opp5: opp-628000000 {
			opp-hz = /bits/ 64 <628000000>;
			opp-microvolt = <706250>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp6: opp-645000000 {
			opp-hz = /bits/ 64 <645000000>;
			opp-microvolt = <712500>;
			opp-supported-hw = <0x018>;
		};

		cci_opp7: opp-663000000 {
			opp-hz = /bits/ 64 <663000000>;
			opp-microvolt = <718750>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp8: opp-680000000 {
			opp-hz = /bits/ 64 <680000000>;
			opp-microvolt = <731250>;
			opp-supported-hw = <0x018>;
		};

		cci_opp9: opp-698000000 {
			opp-hz = /bits/ 64 <698000000>;
			opp-microvolt = <731250>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp10: opp-716000000 {
			opp-hz = /bits/ 64 <716000000>;
			opp-microvolt = <737500>;
			opp-supported-hw = <0x018>;
		};

		cci_opp11: opp-733000000 {
			opp-hz = /bits/ 64 <733000000>;
			opp-microvolt = <750000>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp12: opp-768000000 {
			opp-hz = /bits/ 64 <768000000>;
			opp-microvolt = <762500>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp13: opp-821000000 {
			opp-hz = /bits/ 64 <821000000>;
			opp-microvolt = <781250>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp14: opp-856000000 {
			opp-hz = /bits/ 64 <856000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp15: opp-891000000 {
			opp-hz = /bits/ 64 <891000000>;
			opp-microvolt = <812500>;
			opp-supported-hw = <0x018>;
		};

		cci_opp16: opp-909000000 {
			opp-hz = /bits/ 64 <909000000>;
			opp-microvolt = <818750>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp17: opp-926000000 {
			opp-hz = /bits/ 64 <926000000>;
			opp-microvolt = <831250>;
			opp-supported-hw = <0x018>;
		};

		cci_opp18: opp-961000000 {
			opp-hz = /bits/ 64 <961000000>;
			opp-microvolt = <837500>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp19: opp-997000000 {
			opp-hz = /bits/ 64 <997000000>;
			opp-microvolt = <843750>;
			opp-supported-hw = <0x018>;
		};

		cci_opp20: opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <862500>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp21: opp-1049000000 {
			opp-hz = /bits/ 64 <1049000000>;
			opp-microvolt = <875000>;
			opp-supported-hw = <0x7fe>;
		};

		cci_opp22: opp-1120000000 {
			opp-hz = /bits/ 64 <1120000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x7e6>;
		};

		cci_opp23: opp-1136000000 {
			opp-hz = /bits/ 64 <1136000000>;
			opp-microvolt = <912500>;
			opp-supported-hw = <0x018>;
		};

		cci_opp24: opp-1187000000 {
			opp-hz = /bits/ 64 <1187000000>;
			opp-microvolt = <943750>;
			opp-supported-hw = <0x186>;
		};

		cci_opp25: opp-1277000000 {
			opp-hz = /bits/ 64 <1277000000>;
			opp-microvolt = <1006250>;
			opp-supported-hw = <0x660>;
		};
	};

	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <650000>;
			opp-supported-hw = <0x7fe>;
			required-opps = <&cci_opp0>;
		};

		opp-774000000 {
			opp-hz = /bits/ 64 <774000000>;
			opp-microvolt = <675000>;
			opp-supported-hw = <0x7fe>;
			required-opps = <&cci_opp1>;
		};

		opp-825000000 {
			opp-hz = /bits/ 64 <825000000>;
			opp-microvolt = <700000>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp2>;
		};

		opp-850000000 {
			opp-hz = /bits/ 64 <850000000>;
			opp-microvolt = <700000>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp3>;
		};

		opp-875000000 {
			opp-hz = /bits/ 64 <875000000>;
			opp-microvolt = <718750>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp4>;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <718750>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp5>;
		};

		opp-925000000 {
			opp-hz = /bits/ 64 <925000000>;
			opp-microvolt = <731250>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp6>;
		};

		opp-950000000 {
			opp-hz = /bits/ 64 <950000000>;
			opp-microvolt = <731250>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp7>;
		};

		opp-974000000 {
			opp-hz = /bits/ 64 <974000000>;
			opp-microvolt = <743750>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp8>;
		};

		opp-999000000 {
			opp-hz = /bits/ 64 <999000000>;
			opp-microvolt = <743750>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp9>;
		};

		opp-1025000000 {
			opp-hz = /bits/ 64 <1025000000>;
			opp-microvolt = <762500>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp10>;
		};

		opp-1050000000 {
			opp-hz = /bits/ 64 <1050000000>;
			opp-microvolt = <762500>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp11>;
		};

		opp-1075000000 {
			opp-hz = /bits/ 64 <1075000000>;
			opp-microvolt = <775000>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp12>;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <775000>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp12>;
		};

		opp-1125000000 {
			opp-hz = /bits/ 64 <1125000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp13>;
		};

		opp-1175000000-0 {
			opp-hz = /bits/ 64 <1175000000>;
			opp-microvolt = <831250>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp14>;
		};

		opp-1175000000-1 {
			opp-hz = /bits/ 64 <1175000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp13>;
		};

		opp-1275000000-0 {
			opp-hz = /bits/ 64 <1275000000>;
			opp-microvolt = <843750>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp15>;
		};

		opp-1275000000-1 {
			opp-hz = /bits/ 64 <1275000000>;
			opp-microvolt = <831250>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp14>;
		};

		opp-1325000000-0 {
			opp-hz = /bits/ 64 <1325000000>;
			opp-microvolt = <856250>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp17>;
		};

		opp-1325000000-1 {
			opp-hz = /bits/ 64 <1325000000>;
			opp-microvolt = <843750>;
			opp-supported-hw = <0x7e6>;
			required-opps = <&cci_opp16>;
		};

		opp-1375000000-0 {
			opp-hz = /bits/ 64 <1375000000>;
			opp-microvolt = <881250>;
			opp-supported-hw = <0x018>;
			required-opps = <&cci_opp18>;
		};

		opp-1375000000-1 {
