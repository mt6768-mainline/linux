		thermal: thermal-sensor@1100b000 {
			compatible = "mediatek,mt6768-thermal";
			reg = <0 0x1100b000 0 0xc00>;
			interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&infracfg_ao CLK_INFRA_THERM>, <&infracfg_ao CLK_INFRA_AUXADC>;
			clock-names = "therm", "auxadc";
			resets = <&infracfg_ao MT6768_INFRA_RST0_THERM_CTRL_SWRST>;
			nvmem-cells = <&thermal_calibration>;
			nvmem-cell-names = "calibration-data";
			#thermal-sensor-cells = <1>;
