			reg = <0 0x11c80000 0 0x1000>;
			clocks = <&apmixed CLK_APMIXED_MIPID0_26M>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			clock-output-names = "mipi_tx0_pll";
			status = "disabled";
