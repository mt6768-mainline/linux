			reg = <0 0x17010000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			clocks = <&mmsys CLK_MM_SMI_VENC>,
				 <&vencsys CLK_VENC_SET1_VENC>,
				 <&vencsys CLK_VENC_SET2_JPGENC>;
			clock-names = "apb", "smi", "gals";
			power-domains = <&spm MT6768_POWER_DOMAIN_VENC>;
			mediatek,larb-id = <4>;
		};

		venc_jpg: jpeg-encoder@17030000 {
			compatible = "mediatek,mt8183-jpgenc", "mediatek,mtk-jpgenc";
			reg = <0 0x17030000 0 0x1000>;
			interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_LOW>;
			iommus = <&iommu M4U_PORT_JPGENC_RDMA>,
				 <&iommu M4U_PORT_JPGENC_BSDMA>;
			power-domains = <&spm MT6768_POWER_DOMAIN_VENC>;
			clocks = <&vencsys CLK_VENC_SET2_JPGENC>;
