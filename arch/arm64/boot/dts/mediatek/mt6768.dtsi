	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW &ppi_cluster0>;
	};

	pmu-a75 {
		compatible = "arm,cortex-a75-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW &ppi_cluster1>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0 0xc000000 0 0x40000>,
			      <0 0xc040000 0 0x200000>;
			#interrupt-cells = <4>;
			interrupt-parent = <&gic>;
			interrupt-controller;

			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu6 &cpu7>;
				};
			};
		};

		mcucfg: syscon@c530000 {
			compatible = "mediatek,mt6768-mcucfg", "syscon";
			reg = <0 0xc530000 0 0x10000>;
			#clock-cells = <1>;
		};

		sysirq: interrupt-controller@c53a650 {
			compatible = "mediatek,mt6768-sysirq", "mediatek,mt6577-sysirq";
			reg = <0 0xc53a650 0 0x50>;
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
		};

		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt6768-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			#clock-cells = <1>;
		};

		infracfg_ao: syscon@10001000 {
			compatible = "mediatek,mt6768-infracfg-ao", "syscon";
			reg = <0 0x10001000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pericfg: syscon@10003000 {
			compatible = "mediatek,mt6768-pericfg", "syscon";
			reg = <0 0x10003000 0 0x1000>;
		};

		pio: pinctrl@10005000 {
			compatible = "mediatek,mt6768-pinctrl";
			reg = <0 0x10005000 0 0x1000>,
			      <0 0x10002000 0 0x200>,
			      <0 0x10002200 0 0x200>,
			      <0 0x10002400 0 0x200>,
			      <0 0x10002600 0 0x200>,
			      <0 0x10002800 0 0x200>,
			      <0 0x10002a00 0 0x200>,
			      <0 0x10002c00 0 0x200>,
			      <0 0x10002e00 0 0x200>,
			      <0 0x1000b000 0 0x1000>;
			reg-names = "gpio", "iocfg_lt", "iocfg_lm", "iocfg_lb",
				    "iocfg_bl", "iocfg_rm", "iocfg_rb", "iocfg_rt",
				    "iocfg_tl", "eint";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 187>;
			interrupt-controller;
			interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
			#interrupt-cells = <2>;
		};

		scpsys: clock-controller@10006000 {
			compatible = "mediatek,mt6768-scpsys", "syscon", "simple-mfd";
			reg = <0 0x10006000 0 0x1000>;

			spm: power-controller {
				compatible = "mediatek,mt6768-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				power-domain@MT6768_POWER_DOMAIN_MD1 {
					reg = <MT6768_POWER_DOMAIN_MD1>;
					#power-domain-cells = <0>;

					mediatek,infracfg = <&infracfg_ao>;
				};

				power-domain@MT6768_POWER_DOMAIN_CONN {
					reg = <MT6768_POWER_DOMAIN_CONN>;
					#power-domain-cells = <0>;

					mediatek,infracfg = <&infracfg_ao>;
				};

				power-domain@MT6768_POWER_DOMAIN_MM {
					reg = <MT6768_POWER_DOMAIN_MM>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					clocks = <&topckgen CLK_TOP_MM_SEL>,
						 <&mmsys CLK_MM_SMI_COMMON>,
						 <&mmsys CLK_MM_SMI_COMM0>,
						 <&mmsys CLK_MM_SMI_COMM1>,
						 <&mmsys CLK_MM_SMI_LARB0>,
						 <&mmsys CLK_MM_CAM_MDP>;
					clock-names = "mm", "mm-0", "mm-1",
						      "mm-2", "mm-3", "mm-4";
					mediatek,infracfg = <&infracfg_ao>;

					power-domain@MT6768_POWER_DOMAIN_ISP {
						reg = <MT6768_POWER_DOMAIN_ISP>;
						#power-domain-cells = <0>;

						clocks = <&imgsys CLK_IMG_LARB2>,
							 <&mmsys CLK_MM_SMI_IMG>,
							 <&imgsys CLK_IMG_DIP>,
							 <&imgsys CLK_IMG_FDVT>,
							 <&imgsys CLK_IMG_DPE>;
						clock-names = "isp-0", "isp-1", "isp-2",
							      "isp-3", "isp-4";

						mediatek,infracfg = <&infracfg_ao>;
						mediatek,smi = <&smi_common>;
					};

					power-domain@MT6768_POWER_DOMAIN_CAM {
						reg = <MT6768_POWER_DOMAIN_CAM>;
						#power-domain-cells = <0>;

						clocks = <&camsys CLK_CAM_LARB3>,
							 <&camsys CLK_CAM_DFP_VAD>,
							 <&camsys CLK_CAM_CAM>,
							 <&camsys CLK_CAM_CCU>,
							 <&mmsys CLK_MM_SMI_CAM>;
						clock-names = "cam-0", "cam-1", "cam-2",
							      "cam-3", "cam-4";

						mediatek,infracfg = <&infracfg_ao>;
						mediatek,smi = <&smi_common>;
					};

					power-domain@MT6768_POWER_DOMAIN_VENC {
						reg = <MT6768_POWER_DOMAIN_VENC>;
						#power-domain-cells = <0>;

						clocks = <&vencsys CLK_VENC_VENC>;
						clock-names = "venc-0";

						mediatek,infracfg = <&infracfg_ao>;
						mediatek,smi = <&smi_common>;
					};

					power-domain@MT6768_POWER_DOMAIN_VDEC {
						reg = <MT6768_POWER_DOMAIN_VDEC>;
						#power-domain-cells = <0>;

						clocks = <&vdecsys CLK_VDEC_VDEC>,
							 <&vdecsys CLK_VDEC_ACTIVE>,
							 <&vdecsys CLK_VDEC_EN_ENG>,
							 <&vdecsys CLK_VDEC_LARB1>;
						clock-names = "vdec-0", "vdec-1",
							      "vdec-2", "vdec-3";

						mediatek,infracfg = <&infracfg_ao>;
						mediatek,smi = <&smi_common>;
					};
				};

				mfg_async: power-domain@MT6768_POWER_DOMAIN_MFG_ASYNC {
					reg = <MT6768_POWER_DOMAIN_MFG_ASYNC>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					clocks = <&topckgen CLK_TOP_MFG_SEL>;
					clock-names = "mfg";

					mfg: power-domain@MT6768_POWER_DOMAIN_MFG {
						reg = <MT6768_POWER_DOMAIN_MFG>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						mediatek,infracfg = <&infracfg_ao>;

						power-domain@MT6768_POWER_DOMAIN_MFG_CORE0 {
							reg = <MT6768_POWER_DOMAIN_MFG_CORE0>;
							#power-domain-cells = <0>;
						};

						power-domain@MT6768_POWER_DOMAIN_MFG_CORE1 {
							reg = <MT6768_POWER_DOMAIN_MFG_CORE1>;
							#power-domain-cells = <0>;
						};
					};
				};
			};
		};

		watchdog: watchdog@10007000 {
