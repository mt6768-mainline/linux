		larb3: memory-controller@1a002000 {
			compatible = "mediatek,mt6768-smi-larb", "mediatek,mt8192-smi-larb";
			reg = <0 0x1a002000 0 0x1000>;
			mediatek,smi = <&smi_common>;
			clocks = <&mmsys CLK_MM_SMI_CAM>,
				 <&camsys CLK_CAM_LARB3>;
			power-domains = <&spm MT6768_POWER_DOMAIN_CAM>;
			clock-names = "apb", "smi";
			mediatek,larb-id = <3>;
		};
