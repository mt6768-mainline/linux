#include <dt-bindings/clock/mediatek,mt6768-clk.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/mediatek,mt6768-pinfunc.h>
#include <dt-bindings/clock/mediatek,mt6768-clk.h>
#include <dt-bindings/power/mt6768-power.h>
#include <dt-bindings/gce/mediatek,mt6768-gce.h>
#include <dt-bindings/memory/mt6768-larb-port.h>

/ {
	compatible = "mediatek,mt6768";
	interrupt-parent = <&sysirq>;
	#address-cells = <2>;
	#size-cells = <2>;

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	aliases {
		aal0 = &aal0;
		ccorr0 = &ccorr0;
		color0 = &color0;
		dither0 = &dither0;
		dsi0 = &dsi0;
		gamma0 = &gamma0;
		ovl0 = &ovl0;
		ovl-2l0 = &ovl_2l0;
		mutex = &mutex;
		rdma0 = &rdma0;
		i2c5 = &i2c5;
	};

	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp0-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <650000>;
			required-opps = <&opp2_00>;
		};
		opp0-774000000 {
			opp-hz = /bits/ 64 <774000000>;
			opp-microvolt = <675000>;
			required-opps = <&opp2_01>;
		};
		opp0-850000000 {
			opp-hz = /bits/ 64 <850000000>;
			opp-microvolt = <700000>;
			required-opps = <&opp2_02>;
		};
		opp0-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <718750>;
			required-opps = <&opp2_03>;
		};
		opp0-950000000 {
			opp-hz = /bits/ 64 <950000000>;
			opp-microvolt = <731250>;
			required-opps = <&opp2_04>;
		};
		opp0-999000000 {
			opp-hz = /bits/ 64 <999000000>;
			opp-microvolt = <743750>;
			required-opps = <&opp2_05>;
		};
		opp0-1050000000 {
			opp-hz = /bits/ 64 <1050000000>;
			opp-microvolt = <762500>;
			required-opps = <&opp2_06>;
		};
		opp0-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <775000>;
			required-opps = <&opp2_07>;
		};
		opp0-1175000000 {
			opp-hz = /bits/ 64 <1175000000>;
			opp-microvolt = <800000>;
			required-opps = <&opp2_08>;
		};
		opp0-1275000000 {
			opp-hz = /bits/ 64 <1275000000>;
			opp-microvolt = <831250>;
			required-opps = <&opp2_09>;
		};
		opp0-1325000000 {
			opp-hz = /bits/ 64 <1325000000>;
			opp-microvolt = <843750>;
			required-opps = <&opp2_10>;
		};
		opp0-1375000000 {
			opp-hz = /bits/ 64 <1375000000>;
			opp-microvolt = <856250>;
			required-opps = <&opp2_11>;
		};
		opp0-1450000000 {
			opp-hz = /bits/ 64 <1450000000>;
			opp-microvolt = <881250>;
			required-opps = <&opp2_12>;
		};
		opp0-1500000000 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <893750>;
			required-opps = <&opp2_13>;
		};
		opp0-1625000000 {
			opp-hz = /bits/ 64 <1625000000>;
			opp-microvolt = <931250>;
			required-opps = <&opp2_14>;
		};
		opp0-1700000000 {
			opp-hz = /bits/ 64 <1700000000>;
			opp-microvolt = <962500>;
			required-opps = <&opp2_15>;
		};
	};

	cluster1_opp: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp1-850000000 {
			opp-hz = /bits/ 64 <850000000>;
			opp-microvolt = <675000>;
			required-opps = <&opp2_00>;
		};
		opp1-909000000 {
			opp-hz = /bits/ 64 <909000000>;
			opp-microvolt = <700000>;
			required-opps = <&opp2_01>;
		};
		opp1-998000000 {
			opp-hz = /bits/ 64 <998000000>;
			opp-microvolt = <731250>;
			required-opps = <&opp2_02>;
		};
		opp1-1087000000 {
			opp-hz = /bits/ 64 <1087000000>;
			opp-microvolt = <768750>;
			required-opps = <&opp2_03>;
		};
		opp1-1176000000 {
			opp-hz = /bits/ 64 <1176000000>;
			opp-microvolt = <800000>;
			required-opps = <&opp2_04>;
		};
		opp1-1295000000 {
			opp-hz = /bits/ 64 <1295000000>;
			opp-microvolt = <843750>;
			required-opps = <&opp2_05>;
		};
		opp1-1354000000 {
			opp-hz = /bits/ 64 <1354000000>;
			opp-microvolt = <868750>;
			required-opps = <&opp2_06>;
		};
		opp1-1443000000 {
			opp-hz = /bits/ 64 <1443000000>;
			opp-microvolt = <900000>;
			required-opps = <&opp2_07>;
		};
		opp1-1532000000 {
			opp-hz = /bits/ 64 <1532000000>;
			opp-microvolt = <931250>;
			required-opps = <&opp2_08>;
		};
		opp1-1621000000 {
			opp-hz = /bits/ 64 <1621000000>;
			opp-microvolt = <968750>;
			required-opps = <&opp2_09>;
		};
		opp1-1710000000 {
			opp-hz = /bits/ 64 <1710000000>;
			opp-microvolt = <1000000>;
			required-opps = <&opp2_10>;
		};
		opp1-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1031250>;
			required-opps = <&opp2_11>;
		};
		opp1-1850000000 {
			opp-hz = /bits/ 64 <1850000000>;
			opp-microvolt = <1050000>;
			required-opps = <&opp2_12>;
		};
		opp1-1900000000 {
			opp-hz = /bits/ 64 <1900000000>;
			opp-microvolt = <1062500>;
			required-opps = <&opp2_13>;
		};
		opp1-1950000000 {
			opp-hz = /bits/ 64 <1950000000>;
			opp-microvolt = <1075000>;
			required-opps = <&opp2_14>;
		};
		opp1-2000000000 {
			opp-hz = /bits/ 64 <2000000000>;
			opp-microvolt = <1087500>;
			required-opps = <&opp2_15>;
		};
	};

	cci_opp: opp-table-cci {
		compatible = "operating-points-v2";
		opp-shared;

		opp2_00: opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <650000>;
		};
		opp2_01: opp-558000000 {
			opp-hz = /bits/ 64 <558000000>;
			opp-microvolt = <675000>;
		};
		opp2_02: opp-593000000 {
			opp-hz = /bits/ 64 <593000000>;
			opp-microvolt = <693750>;
		};
		opp2_03: opp-628000000 {
			opp-hz = /bits/ 64 <628000000>;
			opp-microvolt = <706250>;
		};
		opp2_04: opp-663000000 {
			opp-hz = /bits/ 64 <663000000>;
			opp-microvolt = <718750>;
		};
		opp2_05: opp-698000000 {
			opp-hz = /bits/ 64 <698000000>;
			opp-microvolt = <731250>;
		};
		opp2_06: opp-733000000 {
			opp-hz = /bits/ 64 <733000000>;
			opp-microvolt = <750000>;
		};
		opp2_07: opp-768000000 {
			opp-hz = /bits/ 64 <768000000>;
			opp-microvolt = <762500>;
		};
		opp2_08: opp-821000000 {
			opp-hz = /bits/ 64 <821000000>;
			opp-microvolt = <781250>;
		};
		opp2_09: opp-856000000 {
			opp-hz = /bits/ 64 <856000000>;
			opp-microvolt = <800000>;
		};
		opp2_10: opp-909000000 {
			opp-hz = /bits/ 64 <909000000>;
			opp-microvolt = <818750>;
		};
		opp2_11: opp-961000000 {
			opp-hz = /bits/ 64 <961000000>;
			opp-microvolt = <837500>;
		};
		opp2_12: opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <862500>;
		};
		opp2_13: opp-1049000000 {
			opp-hz = /bits/ 64 <1049000000>;
			opp-microvolt = <875000>;
		};
		opp2_14: opp-1120000000 {
			opp-hz = /bits/ 64 <1120000000>;
			opp-microvolt = <900000>;
		};
		opp2_15: opp-1277000000 {
			opp-hz = /bits/ 64 <1277000000>;
			opp-microvolt = <1006250>;
		};
	};

	cci: cci {
		compatible = "mediatek,mt6768-cci", "mediatek,mt8183-cci";
		clocks = <&mcucfg CLK_MCU_PLL_BUS_SEL>,
			 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
		clock-names = "cci", "intermediate";
		operating-points-v2 = <&cci_opp>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x000>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x100>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x200>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x300>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x400>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			enable-method = "psci";
			reg = <0x500>;
			clocks = <&mcucfg CLK_MCU_PLL_LL_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <85>;
			capacity-dmips-mhz = <495>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <32768>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <32768>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_0>;
			mediatek,cci = <&cci>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			enable-method = "psci";
			reg = <0x600>;
			clocks = <&mcucfg CLK_MCU_PLL_L_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster1_opp>;
			dynamic-power-coefficient = <275>;
			capacity-dmips-mhz = <1024>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			mediatek,cci = <&cci>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			enable-method = "psci";
			reg = <0x700>;
			clocks = <&mcucfg CLK_MCU_PLL_L_SEL>,
				 <&topckgen CLK_TOP_ARMPLL_DIVIDER_PLL1_EN>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster1_opp>;
			dynamic-power-coefficient = <275>;
			capacity-dmips-mhz = <1024>;
			cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			mediatek,cci = <&cci>;
		};

		l2_0: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <393216>; // 64K x 6
			cache-line-size = <64>;
			cache-sets = <512>; // I guess
			next-level-cache = <&l3>;
			cache-unified;
		};

		l2_1: l2-cache1 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <524288>; // 256K x 2
			cache-line-size = <64>;
			cache-sets = <512>;
			next-level-cache = <&l3>;
			cache-unified;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu6>;
				};

				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x00010001>;
				entry-latency-us = <600>;
				exit-latency-us = <600>;
				min-residency-us = <1200>;
			};

			CLUSTER_SLEEP: cluster-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x01010001>;
				entry-latency-us = <600>;
				exit-latency-us = <600>;
				min-residency-us = <1200>;
			};
		};
	};

	l3: l3-cache {
		compatible = "cache";
		cache-level = <3>;
		cache-size = <1048576>;
		cache-line-size = <64>;
		cache-sets = <1024>;
		cache-unified;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* required with stock bootloader */
		bootargs = "clk_ignore_unused";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	gpu_opp_table: opp-table-0 {
		compatible = "operating-points-v2";

		opp-299000000 {
			opp-hz = /bits/ 64 <299000000>;
			opp-microvolt = <612500>;
		};

		opp-315000000 {
