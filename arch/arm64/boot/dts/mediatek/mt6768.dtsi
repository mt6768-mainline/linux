		dsi0: dsi@14014000 {
			compatible = "mediatek,mt6768-dsi", "mediatek,mt8183-dsi";
			reg = <0 0x14014000 0 0x1000>;
			interrupts = <GIC_SPI 238 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_DISP>;
			clocks = <&mmsys CLK_MM_DSI0>,
				 <&mmsys CLK_MM_DIG_DSI>,
				 <&mipi_tx0>;
			clock-names = "engine", "digital", "hs";
			phys = <&mipi_tx0>;
			phy-names = "dphy";
			status = "disabled";

