			compatible = "mediatek,mt6768-mmc", "mediatek,mt8183-mmc";
			reg = <0 0x11230000 0 0x1000>,
			      <0 0x11cd0000 0 0x1000>;
			interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>,
				 <&infracfg_ao CLK_INFRA_MSDC0>,
				 <&infracfg_ao CLK_INFRA_MSDC0_SRC>,
				 <&infracfg_ao CLK_INFRA_FAES_FDE>;
			clock-names = "source", "hclk", "source_cg", "crypto";

			status = "disabled";
		};

		mmc1: mmc@11240000 {
			compatible = "mediatek,mt6768-mmc", "mediatek,mt8183-mmc";
			reg = <0 0x11240000 0 0x1000>,
			      <0 0x11c90000 0 0x1000>;
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&topckgen CLK_TOP_MSDC30_1_SEL>,
				 <&infracfg_ao CLK_INFRA_MSDC1>,
				 <&infracfg_ao CLK_INFRA_MSDC1_SRC>;
			clock-names = "source", "hclk", "source_cg";

			status = "disabled";
		};

		mipi_rx_csi0a: syscon@11c10000 {
			compatible = "mediatek,mt6768-mipi0a", "syscon";
			reg = <0 0x11c10000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_rx_csi0b: syscon@11c11000 {
			compatible = "mediatek,mt6768-mipi0b", "syscon";
			reg = <0 0x11c11000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_rx_csi1a: syscon@11c12000 {
			compatible = "mediatek,mt6768-mipi1a", "syscon";
			reg = <0 0x11c12000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_rx_csi1b: syscon@11c13000 {
			compatible = "mediatek,mt6768-mipi1b", "syscon";
			reg = <0 0x11c13000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_rx_csi2a: syscon@11c14000 {
			compatible = "mediatek,mt6768-mipi2a", "syscon";
			reg = <0 0x11c14000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_rx_csi2b: syscon@11c15000 {
			compatible = "mediatek,mt6768-mipi2b", "syscon";
			reg = <0 0x11c15000 0 0x1000>;
			#clock-cells = <1>;
		};

		mipi_tx0: dsi-phy@11c80000 {
			compatible = "mediatek,mt6768-mipi-tx", "mediatek,mt8183-mipi-tx";
			reg = <0 0x11c80000 0 0x1000>;
			clocks = <&apmixedsys CLK_APMIXED_MIPID0_26M>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			clock-output-names = "mipi_tx0_pll";

			status = "disabled";
		};

		u2phy: t-phy@11cc0000 {
			compatible = "mediatek,mt6768-tphy", "mediatek,generic-tphy-v1";
			reg = <0 0x11cc0000 0 0x800>;
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;

			status = "disabled";

			u2port0: usb-phy@11cc0800 {
				reg = <0 0x11cc0800 0 0x100>;
				clocks = <&infracfg_ao CLK_INFRA_ICUSB>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		efuse: efuse@11ce0000 {
			compatible = "mediatek,mt6768-efuse", "mediatek,mt8186-efuse";
			reg = <0 0x11ce0000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			cpu_speedbin: cpu-speedbin@50 {
				reg = <0x50 0x2>;
			};

			thermal_calibration: thermal-calibration@180 {
				reg = <0x180 0x3c>;
			};

			auxadc_calibration: auxadc-calibration@198 {
				reg = <0x198 0x4>;
			};

			svs_calibration: svs-calibration@580 {
				reg = <0x580 0x64>;
			};
		};

		mfgcfg: syscon@13000000 {
			compatible = "mediatek,mt6768-mfgcfg", "mediatek,mt8183-mfgcfg",
				     "syscon";
			reg = <0 0x13000000 0 0x1000>;
			#clock-cells = <1>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MFG_ASYNC>;
		};

		gpu: gpu@13040000 {
			compatible = "mediatek,mt6768-mali", "mediatek,mt8186-mali",
				     "arm,mali-bifrost";
			reg = <0 0x13040000 0 0x4000>;
			interrupts =
				<GIC_SPI 276 IRQ_TYPE_LEVEL_LOW>,
				<GIC_SPI 275 IRQ_TYPE_LEVEL_LOW>,
				<GIC_SPI 274 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "job", "mmu", "gpu";

			clocks = <&mfgcfg CLK_MFG_BG3D>;

			power-domains =
				<&spm MT6768_POWER_DOMAIN_MFG_CORE0>,
				<&spm MT6768_POWER_DOMAIN_MFG_CORE1>;
			power-domain-names = "core0", "core1";

			dynamic-power-coefficient = <1763>;
			operating-points-v2 = <&gpu_opp_table>;
			nvmem-cells = <&cpu_speedbin>;
			nvmem-cell-names = "speed-bin";
			#cooling-cells = <2>;

			status = "disabled";
		};

		mmsys: syscon@14000000 {
			compatible = "mediatek,mt6768-mmsys", "syscon";
			reg = <0 0x14000000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			mboxes = <&gce 0 CMDQ_THR_PRIO_HIGHEST>,
				 <&gce 1 CMDQ_THR_PRIO_HIGHEST>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0 0x1000>;

			port {
				#address-cells = <1>;
				#size-cells = <0>;

				mmsys_ep_main: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&ovl0_in>;
				};
			};
		};

		mutex: mutex@14001000 {
			compatible = "mediatek,mt6768-disp-mutex";
			reg = <0 0x14001000 0 0x1000>;
			interrupts = <GIC_SPI 223 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			mediatek,gce-events = <CMDQ_EVENT_MUTEX0_STREAM_EOF>,
					      <CMDQ_EVENT_MUTEX1_STREAM_EOF>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0x1000 0x1000>;
		};

		smi_common: smi@14002000 {
			compatible = "mediatek,mt6768-smi-common";
			reg = <0 0x14002000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_COMMON>,
				 <&mmsys CLK_MM_SMI_COMMON>,
				 <&mmsys CLK_MM_SMI_COMM0>,
				 <&mmsys CLK_MM_SMI_COMM1>;
			clock-names = "apb", "smi", "gals0", "gals1";
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
		};

		larb0: memory-controller@14003000 {
			compatible = "mediatek,mt6768-smi-larb";
			reg = <0 0x14003000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB0>,
				 <&mmsys CLK_MM_SMI_LARB0>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			mediatek,larb-id = <0>;
			mediatek,smi = <&smi_common>;
		};

		ovl0: ovl@1400b000 {
			compatible = "mediatek,mt6768-disp-ovl", "mediatek,mt8192-disp-ovl";
			reg = <0 0x1400b000 0 0x1000>;
			interrupts = <GIC_SPI 230 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_OVL0>;
			iommus = <&iommu M4U_PORT_DISP_OVL0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xb000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					ovl0_in: endpoint {
						remote-endpoint = <&mmsys_ep_main>;
					};
				};

				port@1 {
					reg = <1>;

					ovl0_out: endpoint {
						remote-endpoint = <&ovl_2l0_in>;
					};
				};
			};
		};

		ovl_2l0: ovl@1400c000 {
			compatible = "mediatek,mt6768-disp-ovl-2l", "mediatek,mt8192-disp-ovl-2l";
			reg = <0 0x1400c000 0 0x1000>;
			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_OVL0_2L>;
			iommus = <&iommu M4U_PORT_DISP_2L_OVL0_LARB0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xc000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					ovl_2l0_in: endpoint {
						remote-endpoint = <&ovl0_out>;
					};
				};

				port@1 {
					reg = <1>;

					ovl_2l0_out: endpoint {
						remote-endpoint = <&rdma0_in>;
					};
				};
			};
		};

		rdma0: rdma@1400d000 {
			compatible = "mediatek,mt6768-disp-rdma";
			reg = <0 0x1400d000 0 0x1000>;
			interrupts = <GIC_SPI 231 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_RDMA0>;
			iommus = <&iommu M4U_PORT_DISP_RDMA0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xd000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					rdma0_in: endpoint {
						remote-endpoint = <&ovl_2l0_out>;
					};
				};

				port@1 {
					reg = <1>;

					rdma0_out: endpoint {
						remote-endpoint = <&color0_in>;
					};
				};
			};
		};

		wdma0: wdma@1400e000 {
			compatible = "mediatek,mt6768-disp-wdma", "mediatek,mt8173-disp-wdma";
			reg = <0 0x1400e000 0 0x1000>;
			interrupts = <GIC_SPI 232 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_WDMA0>;
			iommus = <&iommu M4U_PORT_DISP_WDMA0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xe000 0x1000>;
		};

		color0: color@1400f000 {
			compatible = "mediatek,mt6768-disp-color",
				     "mediatek,mt8173-disp-color";
			reg = <0 0x1400f000 0 0x1000>;
			interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_COLOR0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xf000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					color0_in: endpoint {
						remote-endpoint = <&rdma0_out>;
					};
				};

				port@1 {
					reg = <1>;

					color0_out: endpoint {
						remote-endpoint = <&ccorr0_in>;
					};
				};
			};
		};

		ccorr0: ccorr@14010000 {
			compatible = "mediatek,mt6768-disp-ccorr", "mediatek,mt8183-disp-ccorr";
			reg = <0 0x14010000 0 0x1000>;
			interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_CCORR0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					ccorr0_in: endpoint {
						remote-endpoint = <&color0_out>;
					};
				};

				port@1 {
					reg = <1>;

					ccorr0_out: endpoint {
						remote-endpoint = <&aal0_in>;
					};
				};
			};
		};

		aal0: aal@14011000 {
			compatible = "mediatek,mt6768-disp-aal", "mediatek,mt8183-disp-aal";
			reg = <0 0x14011000 0 0x1000>;
			interrupts = <GIC_SPI 235 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_AAL0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x1000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					aal0_in: endpoint {
						remote-endpoint = <&ccorr0_out>;
					};
				};

				port@1 {
					reg = <1>;

					aal0_out: endpoint {
						remote-endpoint = <&gamma0_in>;
					};
				};
			};
		};

		gamma0: gamma@14012000 {
			compatible = "mediatek,mt6768-disp-gamma", "mediatek,mt8183-disp-gamma";
			reg = <0 0x14012000 0 0x1000>;
			interrupts = <GIC_SPI 236 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_GAMMA0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x2000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					gamma0_in: endpoint {
						remote-endpoint = <&aal0_out>;
					};
				};

				port@1 {
					reg = <1>;

					gamma0_out: endpoint {
						remote-endpoint = <&dither0_in>;
					};
				};
			};
		};

		dither0: dither@14013000 {
			compatible = "mediatek,mt6768-disp-dither", "mediatek,mt8183-disp-dither";
			reg = <0 0x14013000 0 0x1000>;
			interrupts = <GIC_SPI 237 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DISP_DITHER0>;
			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x3000 0x1000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					dither0_in: endpoint {
						remote-endpoint = <&gamma0_out>;
					};
				};

				port@1 {
					reg = <1>;

					dither0_out: endpoint {
						remote-endpoint = <&dsi_in>;
					};
				};
			};
		};

		dsi0: dsi@14014000 {
			compatible = "mediatek,mt6768-dsi", "mediatek,mt8183-dsi";
			reg = <0 0x14014000 0 0x1000>;
			interrupts = <GIC_SPI 238 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT6768_POWER_DOMAIN_MM>;
			clocks = <&mmsys CLK_MM_DSI0>,
				 <&mmsys CLK_MM_DIG_DSI>,
				 <&mipi_tx0>;
			clock-names = "engine", "digital", "hs";
			phys = <&mipi_tx0>;
			phy-names = "dphy";
			resets = <&mmsys MT6768_MMSYS_SW0_RST_B_DSI0>;

			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					dsi_in: endpoint {
						remote-endpoint = <&dither0_out>;
					};
				};

				port@1 {
					reg = <1>;

					dsi_out: endpoint { };
				};
			};
		};

		imgsys: syscon@15020000 {
			compatible = "mediatek,mt6768-imgsys", "syscon";
			reg = <0 0x15020000 0 0x1000>;
			#clock-cells = <1>;
		};

		larb2: memory-controller@15021000 {
			compatible = "mediatek,mt6768-smi-larb";
			reg = <0 0x15021000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_IMG>,
				 <&imgsys CLK_IMG_LARB2>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT6768_POWER_DOMAIN_ISP>;
			mediatek,larb-id = <2>;
			mediatek,smi = <&smi_common>;
		};

		vdecsys: syscon@16000000 {
			compatible = "mediatek,mt6768-vdecsys", "syscon";
			reg = <0 0x16000000 0 0x1000>;
			#clock-cells = <1>;
		};

		larb1: memory-controller@16010000 {
			compatible = "mediatek,mt6768-smi-larb";
			reg = <0 0x16010000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_VDEC>,
				 <&vdecsys CLK_VDEC_LARB1>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT6768_POWER_DOMAIN_VDEC>;
			mediatek,larb-id = <1>;
			mediatek,smi = <&smi_common>;
		};

		vencsys: syscon@17000000 {
			compatible = "mediatek,mt6768-vencsys",
				     "mediatek,mt8183-vencsys", "syscon";
			reg = <0 0x17000000 0 0x1000>;
			#clock-cells = <1>;
		};

		larb4: memory-controller@17010000 {
			compatible = "mediatek,mt6768-smi-larb";
			reg = <0 0x17010000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_VENC>,
				 <&vencsys CLK_VENC_VENC>,
				 <&vencsys CLK_VENC_JPGENC>;
			clock-names = "apb", "smi", "gals";
			power-domains = <&spm MT6768_POWER_DOMAIN_VENC>;
			mediatek,larb-id = <4>;
			mediatek,smi = <&smi_common>;
		};

		camsys: syscon@1a000000 {
			compatible = "mediatek,mt6768-camsys", "syscon";
			reg = <0 0x1a000000 0 0x1000>;
			#clock-cells = <1>;
		};

		larb3: memory-controller@1a002000 {
			compatible = "mediatek,mt6768-smi-larb";
			reg = <0 0x1a002000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_CAM>,
				 <&camsys CLK_CAM_LARB3>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT6768_POWER_DOMAIN_CAM>;
			mediatek,larb-id = <3>;
			mediatek,smi = <&smi_common>;
		};
	};

	thermal_zones: thermal-zones {
		a55_cluster_thermal: a55-cluster-thermal {
			polling-delay-passive = <100>;
			polling-delay = <500>;
			thermal-sensors = <&thermal 0>;
			sustainable-power = <5000>;

			cooling-maps {
				map0 {
					trip = <&a55_target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <3072>;
				};
			};

			trips {
				a55_threshold: a55-trip-point0 {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				a55_target: a55-trip-point1 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				a55_crit: a55-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		a75_cluster_thermal: a75-cluster-thermal {
			polling-delay-passive = <100>;
			polling-delay = <500>;
			thermal-sensors = <&thermal 1>;
			sustainable-power = <5000>;

			cooling-maps {
				map0 {
					trip = <&a75_target>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <4096>;
				};
			};

			trips {
				a75_threshold: a75-trip-point0 {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				a75_target: a75-trip-point1 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				a75_crit: a75-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		cci_thermal: cci-thermal {
			polling-delay-passive = <100>;
			polling-delay = <500>;
			thermal-sensors = <&thermal 2>;
			sustainable-power = <5000>;

			trips {
				cci_threshold: cci-trip-point0 {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cci_target: cci-trip-point1 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cci_crit: cci-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		gpu_thermal: gpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <500>;
			thermal-sensors = <&thermal 3>;
			sustainable-power = <5000>;

			cooling-maps {
				map0 {
					trip = <&gpu_target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};

			trips {
				gpu_threshold: gpu-trip-point0 {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu_target: gpu-trip-point1 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu_crit: gpu-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc_thermal: soc-thermal {
			polling-delay-passive = <100>;
			polling-delay = <500>;
			thermal-sensors = <&thermal 4>;
			sustainable-power = <5000>;

			trips {
				soc_threshold: soc-trip-point0 {
					temperature = <60000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_target: soc-trip-point1 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_crit: soc-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW 0>;
	};
};
