	/* required with stock bootloader */
	scp@10500000 {
		compatible = "mediatek,scp";
	};

	dtbo-dummy {
		dtbo-dummy;
	};
	__symbols__ {
		gpio = "/dtbo-dummy";
		pio = "/dtbo-dummy";
		lcm_power_gpio = "/dtbo-dummy";
		mtkfb = "/dtbo-dummy";
		keypad = "/dtbo-dummy";
		odm = "/dtbo-dummy";
	};
};
